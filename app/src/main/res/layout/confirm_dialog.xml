<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_radius_10"
        android:backgroundTint="#F5F5F5"
        android:gravity="center"
        android:minWidth="350dp"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="50dp"
            android:textColor="#474747"
            android:textSize="20sp"
            android:text="@string/text_game_finish" />

    <TextView
            android:id="@+id/tvWinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="#474747"
            android:textSize="20sp" />

    <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="@string/text_retry_game"
            android:textColor="#474747"
            android:textSize="20sp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

        <Button
                android:id="@+id/btnFinish"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:background="@drawable/background_radius_5"
                android:text="@string/text_finish"
                android:textSize="20sp"
                app:backgroundTint="#474747" />

        <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/background_radius_5"
                android:text="@string/text_retry"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:backgroundTint="#C92A2A" />
    </LinearLayout>
</LinearLayout>